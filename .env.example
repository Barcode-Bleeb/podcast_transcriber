# Copy this file to ".env" and fill in the two values from your Spotify
# Developer app (see docs/spotify-setup.md for the click-by-click guide).
#
#   cp .env.example .env
#
# The .env file is git-ignored, so your secrets stay on your machine.

# From your Spotify app's dashboard ("Settings" page):
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Must EXACTLY match a Redirect URI you registered in the app settings.
# 127.0.0.1 (a loopback address) is one of the few non-HTTPS URIs Spotify
# still allows. Do not use "localhost" — Spotify rejects it.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- Stage 4: summarization (Google Gemini free tier) ----------------------
# Free API key from https://aistudio.google.com/apikey (no billing needed).
# See docs/gemini-setup.md.
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the model if the default isn't available for your key.
# GEMINI_MODEL=gemini-3.6-flash
