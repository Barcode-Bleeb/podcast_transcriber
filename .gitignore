# --- Personal customization (kept local so `git pull` never clobbers it) ---
summary_prompt.txt

# --- Secrets & credentials -------------------------------------------------
# Never commit your Spotify keys or the cached OAuth token.
.env
data/.spotify_token_cache.json
data/*.token.json

# --- Local runtime data ----------------------------------------------------
# Processed-episode tracking, downloaded audio, transcripts, generated PDFs.
# These are machine-local; they should not live in git.
data/episodes.json
data/episodes.json.tmp
data/processed_episodes.json
data/raw/
audio/
transcripts/
summaries/
*.mp3
*.m4a
*.wav

